# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=localhost           # HTTP host (default: localhost)
# MCP_HTTP_ENDPOINT_PATH=/mcp      # HTTP endpoint path (default: /mcp)
# MCP_HTTP_MAX_BODY_BYTES=1048576  # Max request body bytes; 413 over limit, 0 disables (default: 1048576)
# MCP_PUBLIC_URL=                  # Public origin behind a TLS-terminating proxy (e.g. https://mcp.example.com)

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER_TYPE=in-memory   # in-memory | filesystem | supabase | cloudflare-r2 | cloudflare-kv | cloudflare-d1

# ── Session ──────────────────────────────────────────────────────────
# MCP_SESSION_MODE=stateless        # stateless | stateful | auto (default: auto, which resolves to stateful).
                                    # This server ships stateless — no handler asks the client for input
                                    # mid-call, so nothing here needs a session to come back to.
# MCP_HTTP_RESUMABILITY=false       # SSE replay on a dropped stateful stream. Default: true.
                                    # Kill switch only — no effect on stateless serving.
# MCP_HTTP_RESUMABILITY_MAX_EVENTS=512   # Retained per session, oldest evicted first
# MCP_HTTP_RESUMABILITY_TTL_MS=300000    # How long a retained event stays replayable

# ── Memory ───────────────────────────────────────────────────────────
# MCP_GC_PRESSURE_INTERVAL_MS=0     # Opt-in forced Bun.gc(true) interval, ms (Bun only). Drains old-gen backlog
                                    # under sustained HTTP load. Try 60000 if RSS grows. Default: 0.

# ── Logging ───────────────────────────────────────────────────────────
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error
# MCP_LOG_RATE_LIMIT_THRESHOLD=10   # Max emissions per level+message per window; 0 disables
# MCP_LOG_RATE_LIMIT_WINDOW_MS=60000

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=               # OTLP endpoint URL (e.g., http://localhost:4318)

# ── Canvas ────────────────────────────────────────────────────────────
# CANVAS_PROVIDER_TYPE=duckdb           # Enable DataCanvas (Node only). Adds the three eia_dataframe_* tools — without it they are not registered at all — and lets eia_query_route stage rows when called with stage: true

# ── EIA API ───────────────────────────────────────────────────────────
EIA_API_KEY=                            # Required. Free API key from https://www.eia.gov/opendata/register.php
# EIA_BASE_URL=https://api.eia.gov/v2  # EIA API base URL (default: https://api.eia.gov/v2)
# EIA_DATASET_TTL_SECONDS=86400        # Sliding per-dataframe TTL in seconds, extended by every query that references it (default: 86400 = 24 h)
# EIA_DATAFRAME_DROP_ENABLED=false     # Set to true to expose eia_dataframe_drop, which also needs CANVAS_PROVIDER_TYPE=duckdb (default: false)
# EIA_CANVAS_MAX_ROWS=25000            # Cumulative row ceiling for eia_query_route canvas staging, applied on a stage: true call (default: 25000)
# EIA_FACET_VALUE_CAP=50               # Facet values per facet in eia_describe_route output before truncation (default: 50)
